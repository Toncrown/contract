{
    "compilerOptions": {
        "target": "ES2020",
        "outDir": "dist",
        "module": "commonjs",
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "types": [
            "jest",          // Test runner's types (e.g., "mocha")
            "node",          // For Node.js built-in types
            "@ton/sandbox"   // For SandboxContract and related types
        ],
        "lib": ["ES2020", "DOM"] // Added DOM for broader compatibility if any web-like Promise typings are used by dependencies
    },
    "include": [
        "tests/**/*.ts",    // Path to test files
        "wrappers/**/*.ts", // Path to contract wrappers
        "scripts/**/*.ts",  // Path to deploy/interaction scripts
        "build/**/*.ts"     // Path to generated wrappers if in build directory
, "blueprint.config.ts"        // Add any other directories containing TypeScript files you want checked
    ],
    "exclude": [
        "node_modules",
        "dist" // Exclude output directory from being re-parsed
    ]
}